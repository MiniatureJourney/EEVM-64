`timescale 1ns / 1ps

// =============================================================================
// Testbench : tb_rv64_multiplier_unit
// DUT       : rv64_multiplier_unit (default: 2 stages, Brent-Kung, CSA_3TO2)
// Checks    : MUL, MULH, MULHSU, MULHU; directed edge vectors; random vectors;
//             one-request-per-cycle throughput; valid bubbles; reset behavior.
//
// Compile this with the project's existing helper RTL. The reference model uses
// behavioral multiplication intentionally; it is independent of the Vedic tree.
// =============================================================================

module tb_rv64_multiplier_unit;
    localparam logic [1:0] OP_MUL    = 2'b00;
    localparam logic [1:0] OP_MULH   = 2'b01;
    localparam logic [1:0] OP_MULHSU = 2'b10;
    localparam logic [1:0] OP_MULHU  = 2'b11;

    logic clk = 1'b0;
    logic rst_n = 1'b0;
    logic valid_in = 1'b0;
    logic [1:0] op_sel = 2'b00;
    logic [63:0] rs1 = 64'b0;
    logic [63:0] rs2 = 64'b0;
    logic valid_out;
    logic [63:0] result;

    integer errors = 0;
    integer checks = 0;
    logic expected_valid_prev = 1'b0;
    logic [63:0] expected_result_prev = 64'b0;

    always #5 clk = ~clk;

    rv64_multiplier_unit #(
        .PIPELINE_STAGES(2),
        .ADDER_TYPE("BRENT_KUNG"),
        .COMBINE("CSA_3TO2")
    ) dut (
        .clk(clk), .rst_n(rst_n), .valid_in(valid_in), .op_sel(op_sel),
        .rs1(rs1), .rs2(rs2), .valid_out(valid_out), .result(result)
    );

    function automatic logic [63:0] reference_result(
        input logic [63:0] a,
        input logic [63:0] b,
        input logic [1:0]  operation
    );
        logic [127:0] unsigned_a;
        logic [127:0] unsigned_b;
        logic [127:0] unsigned_product;
        logic signed [127:0] signed_a;
        logic signed [127:0] signed_b;
        logic signed [127:0] signed_product;
        begin
            unsigned_a = {64'b0, a};
            unsigned_b = {64'b0, b};
            signed_a   = {{64{a[63]}}, a};
            signed_b   = {{64{b[63]}}, b};

            case (operation)
                OP_MUL: begin
                    // Low half is identical for signed and unsigned RV64 multiply.
                    unsigned_product = unsigned_a * unsigned_b;
                    reference_result = unsigned_product[63:0];
                end
                OP_MULH: begin
                    signed_product = signed_a * signed_b;
                    reference_result = signed_product[127:64];
                end
                OP_MULHSU: begin
                    // A is sign-extended; B is zero-extended and therefore nonnegative
                    // when represented by the signed 128-bit reference operand.
                    signed_b = $signed({64'b0, b});
                    signed_product = signed_a * signed_b;
                    reference_result = signed_product[127:64];
                end
                OP_MULHU: begin
                    unsigned_product = unsigned_a * unsigned_b;
                    reference_result = unsigned_product[127:64];
                end
                default: reference_result = 64'b0;
            endcase
        end
    endfunction

    // One input is offered per call. The expected output at this sampling edge is
    // the transaction accepted on the preceding edge by Stage 1.
    task automatic step_and_check(
        input logic        v,
        input logic [63:0] a,
        input logic [63:0] b,
        input logic [1:0]  operation
    );
        begin
            @(negedge clk);
            valid_in = v;
            rs1 = a;
            rs2 = b;
            op_sel = operation;

            @(posedge clk);
            #1; // allow nonblocking assignments/register outputs to settle
            checks = checks + 1;
            if (valid_out !== expected_valid_prev) begin
                errors = errors + 1;
                $display("FAIL valid: cycle-check=%0d got=%b expected=%b", checks,
                         valid_out, expected_valid_prev);
            end
            if (expected_valid_prev && (result !== expected_result_prev)) begin
                errors = errors + 1;
                $display("FAIL result: cycle-check=%0d got=%h expected=%h",
                         checks, result, expected_result_prev);
            end

            expected_valid_prev = v;
            if (v)
                expected_result_prev = reference_result(a, b, operation);
        end
    endtask

    task automatic send_op(
        input logic [63:0] a,
        input logic [63:0] b,
        input logic [1:0]  operation
    );
        begin
            step_and_check(1'b1, a, b, operation);
        end
    endtask

    logic [63:0] random_a, random_b;
    integer i, op;

    initial begin
        // Reset for two rising edges, with no pending transactions.
        repeat (2) @(negedge clk);
        rst_n = 1'b1;
        step_and_check(1'b0, 64'b0, 64'b0, OP_MUL);

        // Directed values exercise signed extremes, unsigned extremes, and
        // boundaries near the 8/16/32/64-bit precision tiers.
        send_op(64'b0, 64'b0, OP_MUL);
        send_op(64'hFFFF_FFFF_FFFF_FFFF, 64'd1, OP_MUL);
        send_op(64'h8000_0000_0000_0000, 64'hFFFF_FFFF_FFFF_FFFF, OP_MULH);
        send_op(64'h8000_0000_0000_0000, 64'hFFFF_FFFF_FFFF_FFFF, OP_MULHSU);
        send_op(64'hFFFF_FFFF_FFFF_FFFF, 64'hFFFF_FFFF_FFFF_FFFF, OP_MULHU);
        send_op(64'h7FFF_FFFF_FFFF_FFFF, 64'h7FFF_FFFF_FFFF_FFFF, OP_MULH);
        send_op(64'hFFFF_FFFF_FFFF_FF80, 64'h0000_0000_0000_0080, OP_MULH);
        send_op(64'h0000_0000_0000_00FF, 64'h0000_0000_0000_0100, OP_MULHU);
        send_op(64'h0000_0000_0000_FFFF, 64'h0000_0000_0001_0000, OP_MULHU);
        send_op(64'h0000_0000_7FFF_FFFF, 64'h0000_0000_8000_0000, OP_MULHU);
        send_op(64'h5555_5555_5555_5555, 64'hAAAA_AAAA_AAAA_AAAA, OP_MULHU);

        // Interleave all four operation encodings under continuous throughput.
        for (op = 0; op < 4; op = op + 1) begin
            send_op(64'hFFFF_FFFF_FFFF_FFFF, 64'h8000_0000_0000_0001, op[1:0]);
            send_op(64'h8000_0000_0000_0000, 64'h0000_0000_0000_0003, op[1:0]);
            send_op(64'h0000_0000_0000_0007, 64'h0000_0000_0000_0009, op[1:0]);
        end

        // Deterministic pseudorandom stream. Drive one request each cycle so the
        // scoreboard also checks initiation interval = 1 and operation alignment.
        for (i = 0; i < 1000; i = i + 1) begin
            random_a = {$urandom, $urandom};
            random_b = {$urandom, $urandom};
            send_op(random_a, random_b, i[1:0]);
        end

        // Flush the last request and then confirm an invalid cycle remains invalid.
        step_and_check(1'b0, 64'b0, 64'b0, OP_MUL);
        step_and_check(1'b0, 64'b0, 64'b0, OP_MUL);

        if (errors == 0)
            $display("PASS: rv64_multiplier_unit checks=%0d; all operation paths matched.", checks);
        else
            $display("FAIL: rv64_multiplier_unit errors=%0d checks=%0d", errors, checks);

        if (errors != 0) $fatal(1, "rv64_multiplier_unit regression failed");
        $finish;
    end
endmodule
