// =============================================================================
// Testbench : tb_precision_detector
// DUT       : precision_detector
// Spec ref  : EEVM-64_architecturePlan.pdf §4 — "precision_detector: boundary
//             values at exactly 7/8/9, 15/16/17, 31/32/33, 63/64 bits, signed and
//             unsigned."
//
// Method    : Self-checking against a behavioural reference that is written the
//             "obvious" way and shares no structure with the RTL: it measures the
//             exact minimum bit width of each operand with a loop, maps width ->
//             level (<=8 ->0, <=16 ->1, <=32 ->2, else 3), and takes the max.
//               unsigned : width = index of highest set bit + 1   (0 for x = 0)
//               signed   : width = 1 + index of highest bit that differs from the
//                          sign bit, + 1 for the sign itself (1 for x in {0,-1})
//             Stimulus, all run in BOTH signed and unsigned mode:
//               (1) width sweep: for EVERY pair of operand widths (wa, wb) in
//                   0..64, REP operand pairs whose top bit sits exactly at that
//                   width — this hits every boundary (7/8/9, 15/16/17, 31/32/33,
//                   63/64) for operand a, for operand b, and for each as the max;
//               (2) directed corner list (0, +-1, +-2^k, 2^k-1, alternating bits...)
//                   crossed with itself;
//               (3) width-shaped random vectors (random widths, random signs);
//               (4) fully random vectors.
//             A coverage check requires every level to occur in both modes.
//
// Pass/fail : prints one PASS/FAIL summary line for testingDataBlockwise.
// =============================================================================
`timescale 1ns / 1ps

module tb_precision_detector #(
    parameter int REP      = 4,        // operand pairs per (wa, wb, mode) in the width sweep
    parameter int N_SHAPED = 50000,    // width-shaped random vectors
    parameter int N_RANDOM = 50000     // fully random vectors
);

    logic [63:0] a, b;
    logic        is_signed;
    logic [1:0]  level;

    precision_detector dut (.a(a), .b(b), .is_signed(is_signed), .level(level));

    integer errors;
    integer n_vec;
    integer cov [0:7];          // index = {is_signed, level}

    // ---- reference model --------------------------------------------------------
    function automatic int ref_width_u(input logic [63:0] x);
        int w;
        begin
            w = 0;
            for (int i = 0; i < 64; i++) if (x[i]) w = i + 1;
            ref_width_u = w;
        end
    endfunction

    function automatic int ref_width_s(input logic [63:0] x);
        int w;
        begin
            w = 1;
            for (int i = 0; i < 63; i++) if (x[i] !== x[63]) w = i + 2;
            ref_width_s = w;
        end
    endfunction

    function automatic logic [1:0] width_to_level(input int w);
        begin
            if      (w <= 8)  width_to_level = 2'd0;
            else if (w <= 16) width_to_level = 2'd1;
            else if (w <= 32) width_to_level = 2'd2;
            else              width_to_level = 2'd3;
        end
    endfunction

    function automatic logic [1:0] ref_level(input logic [63:0] x, input logic [63:0] y, input logic s);
        logic [1:0] lx, ly;
        begin
            lx = width_to_level(s ? ref_width_s(x) : ref_width_u(x));
            ly = width_to_level(s ? ref_width_s(y) : ref_width_u(y));
            ref_level = (lx > ly) ? lx : ly;
        end
    endfunction

    // ---- stimulus helpers ---------------------------------------------------------
    function automatic logic [63:0] rnd64();
        rnd64 = {$urandom, $urandom};
    endfunction

    function automatic logic [63:0] low_mask(input int n);   // n low bits set, 0..64
        begin
            if (n >= 64) low_mask = '1;
            else if (n <= 0) low_mask = 64'd0;
            else low_mask = (64'(1) << n) - 64'(1);
        end
    endfunction

    // value whose highest set bit is exactly bit w-1 (w = 0 -> 0)
    function automatic logic [63:0] gen_u(input int w);
        begin
            if (w <= 0) gen_u = 64'd0;
            else        gen_u = (64'(1) << (w - 1)) | (rnd64() & low_mask(w - 1));
        end
    endfunction

    // value needing exactly w bits in two's complement (w <= 1 -> 0 or -1)
    function automatic logic [63:0] gen_s(input int w);
        logic [63:0] p;
        begin
            if (w <= 1) gen_s = ($urandom & 1) ? '1 : 64'd0;
            else begin
                p = (64'(1) << (w - 2)) | (rnd64() & low_mask(w - 2));   // +ve, w bits signed
                gen_s = ($urandom & 1) ? ~p : p;                          // ~p = -p-1, also w bits
            end
        end
    endfunction

    task automatic check(input logic [63:0] av, input logic [63:0] bv, input logic s, input string tag);
        logic [1:0] expv;
        begin
            a = av; b = bv; is_signed = s;
            #1;
            expv = ref_level(av, bv, s);
            n_vec = n_vec + 1;
            cov[{s, expv}] = cov[{s, expv}] + 1;
            if (level !== expv) begin
                errors = errors + 1;
                if (errors <= 10)
                    $display("FAIL [%s] signed=%0b a=%h b=%h -> level=%0d (expected %0d)", tag, s, av, bv, level, expv);
            end
        end
    endtask

    // ---- directed corner values ------------------------------------------------------
    localparam int ND = 30;
    logic [63:0] dv [0:ND-1];
    initial begin
        dv[0]  = 64'h0000000000000000;   // 0
        dv[1]  = 64'h0000000000000001;   // 1
        dv[2]  = 64'hFFFFFFFFFFFFFFFF;   // -1 / max unsigned
        dv[3]  = 64'h0000000000000002;   // 2
        dv[4]  = 64'hFFFFFFFFFFFFFFFE;   // -2
        dv[5]  = 64'h000000000000007F;   // 127  : 7-bit unsigned, max 8-bit signed
        dv[6]  = 64'h0000000000000080;   // 128  : 8-bit unsigned, needs 9-bit signed
        dv[7]  = 64'hFFFFFFFFFFFFFF80;   // -128 : fits 8-bit signed
        dv[8]  = 64'hFFFFFFFFFFFFFF7F;   // -129 : needs 9-bit signed
        dv[9]  = 64'h00000000000000FF;   // 255
        dv[10] = 64'h0000000000000100;   // 256
        dv[11] = 64'h0000000000007FFF;   // 32767
        dv[12] = 64'h0000000000008000;   // 32768
        dv[13] = 64'hFFFFFFFFFFFF8000;   // -32768
        dv[14] = 64'hFFFFFFFFFFFF7FFF;   // -32769
        dv[15] = 64'h000000000000FFFF;   // 65535
        dv[16] = 64'h0000000000010000;   // 65536
        dv[17] = 64'h000000007FFFFFFF;   // 2^31-1
        dv[18] = 64'h0000000080000000;   // 2^31
        dv[19] = 64'hFFFFFFFF80000000;   // -2^31
        dv[20] = 64'hFFFFFFFF7FFFFFFF;   // -2^31-1
        dv[21] = 64'h00000000FFFFFFFF;   // 2^32-1
        dv[22] = 64'h0000000100000000;   // 2^32
        dv[23] = 64'h7FFFFFFFFFFFFFFF;   // 2^63-1
        dv[24] = 64'h8000000000000000;   // -2^63 / 2^63
        dv[25] = 64'h8000000000000001;
        dv[26] = 64'h5555555555555555;
        dv[27] = 64'hAAAAAAAAAAAAAAAA;
        dv[28] = 64'h00000000AAAAAAAA;
        dv[29] = 64'hFFFFFFFFFFFF5555;
    end

    integer wa, wb, k, m, i, j;
    logic [63:0] ra, rb;

    initial begin
        $dumpfile("tb_precision_detector.vcd");
        $dumpvars(0, tb_precision_detector);
        errors = 0;
        n_vec  = 0;
        for (i = 0; i < 8; i = i + 1) cov[i] = 0;
        #1;   // let dv[] settle

        // (1) width sweep: every (wa, wb) pair, both modes
        for (m = 0; m < 2; m = m + 1)
            for (wa = 0; wa <= 64; wa = wa + 1)
                for (wb = 0; wb <= 64; wb = wb + 1)
                    for (k = 0; k < REP; k = k + 1) begin
                        if (m == 0) check(gen_u(wa), gen_u(wb), 1'b0, "sweep-u");
                        else        check(gen_s(wa), gen_s(wb), 1'b1, "sweep-s");
                    end

        // (2) directed corner list x itself, both modes
        for (m = 0; m < 2; m = m + 1)
            for (i = 0; i < ND; i = i + 1)
                for (j = 0; j < ND; j = j + 1)
                    check(dv[i], dv[j], m[0], "directed");

        // (3) width-shaped random
        for (k = 0; k < N_SHAPED; k = k + 1) begin
            wa = $urandom % 65;
            wb = $urandom % 65;
            m  = $urandom & 1;
            if (m == 0) check(gen_u(wa), gen_u(wb), 1'b0, "shaped-u");
            else        check(gen_s(wa), gen_s(wb), 1'b1, "shaped-s");
        end

        // (4) fully random
        for (k = 0; k < N_RANDOM; k = k + 1) begin
            ra = rnd64();
            rb = rnd64();
            check(ra, rb, $urandom & 1, "random");
        end

        #1;
        // coverage: all four levels in both modes
        for (i = 0; i < 8; i = i + 1)
            if (cov[i] == 0) begin
                errors = errors + 1;
                $display("FAIL: coverage hole - signed=%0d level=%0d never exercised", i / 4, i % 4);
            end

        if (errors == 0)
            $display("PASS: precision_detector - %0d vectors (width sweep of all 65x65 width pairs x signed/unsigned, %0d directed, %0d width-shaped random, %0d random) match the reference; all 4 levels hit in both modes.",
                     n_vec, 2*ND*ND, N_SHAPED, N_RANDOM);
        else
            $display("FAIL: precision_detector - %0d mismatches/holes found in %0d vectors.", errors, n_vec);
        $finish;
    end

endmodule
